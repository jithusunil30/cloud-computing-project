# NitroStack Configuration
NITRO_LOG_LEVEL=info
NITROSTACK_APP_MODE=universal
HOST=0.0.0.0
PORT=3000

# =============================================================================
# Live Cloud Provider Telemetry (Read-Only) Over Internet
# =============================================================================
# AWS Live Telemetry (Cost Explorer & CloudWatch)
# Set these in your Render Environment or local .env to query live AWS APIs:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# GCP Live Telemetry (Cloud Monitoring & Billing Export)
GCP_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Optional: Electricity Maps API for global marginal grid intensity
ELECTRICITY_MAPS_API_KEY=
